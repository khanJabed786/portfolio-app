rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Profile and other public content: public read, admin write
    match /public/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicCertificates/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public projects: public read, admin write
    match /publicProjects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages: public create, admin management
    match /contactMessages/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Analytics events: public create/read, admin management
    match /analyticsEvents/{document=**} {
      allow read, write: if isAdmin() || request.auth == null;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
